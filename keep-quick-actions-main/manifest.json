{
  "manifest_version": 3,
  "name": "Google Keep Quick Actions",
  "version": "1.0.0",
  "description": "Google Keepのメニュー項目をツールバーに直接表示して効率化",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["https://keep.google.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
